{
  "name": "dsh-open-session-workdir",
  "version": "0.1.0",
  "description": "Open the current session's working directory in the host file manager (Windows Explorer on Windows) straight from the DSH session header. Client-only plugin: it reuses the core session.openWorkspacePath remote and ships no host endpoint, no model tool and no new attack surface.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "cordis",
    "workspace",
    "explorer"
  ],
  "files": [
    "src/",
    "cordis.patch.yml",
    "README.md",
    "ACCEPTANCE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.1-rc.2"
  }
}
